{
  "name": "ai-diving-monitor",
  "version": "0.2.0",
  "private": true,
  "description": "AI dive coach: import UDDF dive computer logs, get data-driven dive reviews and track your progress.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "bun run typecheck && bun run lint && bun run test:coverage && bun run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}
